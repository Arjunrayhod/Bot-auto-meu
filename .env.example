# College Portal Credentials
PORTAL_LOGIN_URL=https://meu.gnums.co.in/Login.aspx
PORTAL_DASHBOARD_URL=https://meu.gnums.co.in/StudentPanel/StudentDashboard.aspx
PORTAL_ROLE=Student
PORTAL_USERNAME=your_email@gmail.com
PORTAL_PASSWORD=your_portal_password

# Telegram Notification Settings
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Google Gemini AI Solver
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Automation Parameters
HEADLESS=True
CHECK_INTERVAL_SECONDS=900
SERVER_ERROR_WAIT_SECONDS=300
MAX_RETRIES=3
QUIZ_SAFETY_TIMER_RATIO=0.80

# Gmail Early Warning & Quiz Sniper
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_16_char_app_password
